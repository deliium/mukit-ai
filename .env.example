# Copy to `.env` and fill in at least one provider API key.
# Never commit `.env` — secrets stay on the host / in Compose env only.

# --- LLM providers (backend only; never expose to the frontend) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# openai | deepseek | fake (must match a configured provider; fake needs LLM_FAKE_MODE=1)
DEFAULT_LLM_PROVIDER=openai
# Per-provider HTTP call; staged generation may need 120–180s (body can outlive headers).
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.7

# Credit-free deterministic provider for local demos, Playwright, and Docker acceptance.
# When enabled, "Fake (deterministic)" appears in GET /llm/models and never calls OpenAI/DeepSeek.
# Prefer ON for automated E2E; leave OFF (or unset) in production unless intentionally demoing.
# If both fake mode and real keys are set, fake is listed and becomes default unless
# DEFAULT_LLM_PROVIDER explicitly selects a configured real provider.
LLM_FAKE_MODE=0
# LLM_FAKE_MODEL=fake-deterministic

# --- AI runtime: per-operation model routing (optional; defaults use LLM providers) ---
# Canonical model_id format: provider:model (e.g. openai:gpt-4o-mini, fake:fake-deterministic)
# AI_OP_GENERATE=
# AI_OP_GENERATE_PLANNER=   # hybrid: language planner (uncollapsed when pipeline≠llm_only)
# AI_OP_GENERATE_COMPOSER=  # hybrid: symbolic_composer (fake:symbolic-tiny or local:music-transformer)
# GENERATION_HYBRID_MAX_TOKEN_RETRIES=1
# Optional last-resort LLM note rewrite on hybrid composition failure is request flag allow_llm_composition_repair
# AI_OP_REGION_EDIT=
# AI_OP_ARRANGE_PREVIEW=
# AI_OP_DEVELOPMENT_PREVIEW=
# AI_OP_REHARMONIZE_AI=
# AI_OP_CREATIVE_MOTIF=
# AI_OP_SPOTTING_SUGGEST=  # language_planner; explicit Picture-tab cue drafts only
# AI_OP_TRANSCRIBE=
# AI_OP_EMBED=
# AI_OP_AUDIO_RENDER=
# Per-agent model overrides (V4 multi-agent; optional — see docs/multi-agent.md)
# AI_AGENT_CREATIVE_DIRECTOR_MODEL=
# AI_AGENT_HARMONY_MODEL=
# AI_AGENT_MELODY_MOTIF_MODEL=
# AI_AGENT_ARRANGEMENT_MODEL=
# AI_AGENT_CRITIC_MODEL=
# AI_AGENT_STRUCTURE_FORM_MODEL=
# AI_AGENT_ORCHESTRATION_MODEL=
# AI_AGENT_PERFORMANCE_EXPRESSION_MODEL=
# AI_AGENT_PRODUCTION_MODEL=

# --- In-process plugins (discovery only; install + enable required; see docs/plugin-sdk.md) ---
# PLUGIN_PATHS discovers manifests. It does not import or activate plugin code.
# Path-separator list of plugin directories, or parents whose children contain plugin.manifest.json.
# Shipped examples stay undiscovered until you point here, and stay disabled until install/enable:
# PLUGIN_PATHS=backend/examples/plugins
# PLUGIN_MAX_COUNT=32
# PLUGIN_MAX_MANIFEST_BYTES=65536
# PLUGIN_MAX_EXPORT_BYTES=2000000
# PLUGIN_RELOAD_ENABLED=1

# Explicit fallback chains (comma-separated model ids); never silent:
# AI_FALLBACK_GENERATE=
# AI_FALLBACK_REGION_EDIT=
# AI_FALLBACK_ARRANGE_PREVIEW=
# AI_FALLBACK_DEVELOPMENT_PREVIEW=
# AI_FALLBACK_REHARMONIZE_AI=
# AI_FALLBACK_CREATIVE_MOTIF=
# Optional extra registry JSON (list or {models: [...]}); unset = env LLM providers only
# AI_MODEL_REGISTRY_PATH=

# --- Optional local AI (OpenAI-compatible sidecar; default Compose does not start it) ---
# Enable only when a local server is reachable (Compose --profile local-ai or host process).
# App never loads GGUF/safetensors; discovery never returns weight paths.
# LOCAL_LLM_ENABLED=0
# COLLABORATION_ENABLED=0
# PREFERENCE_LEARNING_ENABLED=0
# Ensemble arbitration (multi-model symbolic generate preview). Default off.
# Preview requires ENSEMBLE_ARBITRATION_ENABLED=1. Status is not on /ready.
# ENSEMBLE_ARBITRATION_ENABLED=0
# ENSEMBLE_MAX_MODELS=3
# ENSEMBLE_MAX_WALL_MS=120000
# ENSEMBLE_ALLOW_PARALLEL=0
# ENSEMBLE_FAKE=0
# --- Optional Ardour OSC companion (default off; process-memory session) ---
# ARDOUR_COMPANION_ENABLED=0
# ARDOUR_COMPANION_FAKE=0
# ARDOUR_COMPANION_ALLOW_PUBLIC_HOSTS=0
# ARDOUR_COMPANION_DEFAULT_HOST=127.0.0.1
# ARDOUR_COMPANION_DEFAULT_OSC_PORT=3819
# ARDOUR_COMPANION_DEFAULT_FEEDBACK_PORT=8000
# ARDOUR_COMPANION_FEEDBACK_STALE_MS=3000
# ARDOUR_COMPANION_COMMAND_TIMEOUT_MS=2000
# Ardour session exchange (MIDI/stem packages; independent of companion UDP)
# ARDOUR_EXCHANGE_ENABLED=0
# ARDOUR_EXCHANGE_ROOT=
# ARDOUR_EXCHANGE_MAX_PACKAGE_BYTES=26214400
# ARDOUR_EXCHANGE_MAX_PACKAGES=32
# ARDOUR_EXCHANGE_PACKAGE_TTL_SECONDS=86400
# See docs/ardour-companion.md
# --- Optional capability-aware AI job scheduling (default off) ---
# AI_SCHEDULING_ENABLED=0
# AI_SCHEDULING_DEFAULT_MODE=prefer_local
# AI_SCHEDULING_ALLOW_PUBLIC_CLOUD=0
# AI_SCHEDULING_MAX_ATTEMPTS=2
# AI_SCHEDULING_FIXED_NODE_ID=
# # Controller-local resource hints when descriptor limits omit them (never override ExecutionNode heartbeats):
# AI_SCHEDULING_LOCAL_MEMORY_AVAILABLE_MB=
# AI_SCHEDULING_LOCAL_MEMORY_TOTAL_MB=
# AI_SCHEDULING_LOCAL_DEVICE_CLASS=
# AI_SCHEDULING_LOCAL_ESTIMATED_LATENCY_MS=
# See docs/ai-job-scheduling.md
# --- Optional distributed ExecutionNodes (trusted LAN; default off) ---
# AI_EXECUTION_NODES_ENABLED=0
# AI_EXECUTION_NODE_TOKEN=
# AI_EXECUTION_NODE_ROLE=controller
# AI_EXECUTION_NODE_CONTROLLER_URL=
# AI_EXECUTION_NODE_HEARTBEAT_INTERVAL_SECONDS=10
# AI_EXECUTION_NODE_HEARTBEAT_TTL_SECONDS=30
# AI_EXECUTION_NODE_FAKE=0
# AI_EXECUTION_NODE_MAX_NODES=8
# AI_EXECUTION_NODE_MAX_CONCURRENCY=2
# AI_EXECUTION_NODE_ADDRESS_ALLOW_CIDRS=
# AI_EXECUTION_NODE_ALLOW_HOSTNAME=0
# See docs/execution-nodes.md and compose.execution-node.yml (worker profile).
# LOCAL_LLM_BASE_URL=http://local-llm:8080/v1
# # For vLLM profile use e.g. http://local-llm-vllm:8000/v1
# LOCAL_LLM_MODEL=local-instruct
# LOCAL_LLM_CONTEXT_SIZE=4096
# LOCAL_LLM_QUANTIZATION=Q4_K_M
# LOCAL_LLM_DEVICE=rocm
# # Vulkan fallback when ROCm is broken on gfx1152: LOCAL_LLM_DEVICE=vulkan
# LOCAL_LLM_MEMORY_LIMIT_MB=12288
# LOCAL_LLM_MAX_CONCURRENCY=1
# LOCAL_LLM_TIMEOUT_SECONDS=180
# LOCAL_LLM_API_KEY=local
# # Compose sidecar only (never in discovery responses):
# # LOCAL_LLM_MODELS_HOST_PATH=./models/llm
# # LOCAL_LLM_GGUF_FILE=model.gguf
# See docs/local-ai.md for profiles: local-ai, local-ai-vllm, training.

# --- Persistence & rendering ---
# Docker Compose sets PROJECT_DB_PATH=/data/projects.db on the named volume.
PROJECT_DB_PATH=/data/projects.db
COMPOSITION_WAV_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2

# --- MIDI / MusicXML import limits (backend; independent from LLM generation budgets) ---
# Enforced in application code even when requests bypass Nginx.
IMPORT_MAX_UPLOAD_BYTES=5242880
IMPORT_MAX_EXPANDED_BYTES=26214400
IMPORT_MAX_COMPRESSION_RATIO=50
IMPORT_MAX_ARCHIVE_ENTRIES=64
IMPORT_MAX_TRACKS=64
IMPORT_MAX_NOTES=100000
IMPORT_MAX_BARS=512
IMPORT_MAX_PPQ=1920
IMPORT_MAX_METADATA_CHANGES=512
IMPORT_MAX_ACTIVE_NOTES=512
# IMPORT_DEFAULT_TARGET_PPQ=480

# --- Monophonic audio transcription (backend; distinct from MIDI/MusicXML import) ---
# Preview-only ingress → transcription.preview.v1; never persists audio or confidence on V2 notes.
# Prefer client-side WAV PCM uploads. See docs/audio-transcription.md.
AUDIO_MAX_UPLOAD_BYTES=10485760
AUDIO_MAX_DURATION_SECONDS=60
AUDIO_MAX_SAMPLE_RATE=48000
AUDIO_CONFIDENCE_INCLUDE_THRESHOLD=0.5
# auto | fake:audio-mono | librosa_pyin | basic_pitch
AUDIO_TRANSCRIPTION_ENGINE=auto
# When 1, allow fake:audio-mono outside explicit engine pin (CI / local without extras).
AUDIO_FAKE_MODE=0
# AUDIO_DEFAULT_TARGET_PPQ=480
# AUDIO_DEFAULT_TEMPO_BPM=120

# --- V4 mixed audio recovery (ingress; distinct from mono AUDIO_* and neural egress) ---
# Job + optional separation → session preview → Apply → Bind (project_id required).
# Confidence lives on audio.recovery.result.v1 overlay — never on composition.v2 notes.
# Asset files under AUDIO_RECOVERY_ASSET_ROOT (never DATASET_ROOT). See docs/audio-recovery.md.
# AUDIO_RECOVERY_ASSET_ROOT=  # default: <dir of PROJECT_DB_PATH>/audio_recovery_assets
AUDIO_RECOVERY_MAX_UPLOAD_BYTES=26214400
AUDIO_RECOVERY_MAX_DURATION_SECONDS=120
AUDIO_RECOVERY_MAX_SAMPLE_RATE=48000
AUDIO_RECOVERY_CONFIDENCE_INCLUDE_THRESHOLD=0.5
# auto | fake:audio-recovery | local:estimators | sidecar:recovery
AUDIO_RECOVERY_ENGINE=auto
# off | auto | fake:stems | sidecar:demucs
AUDIO_RECOVERY_SEPARATION_ENGINE=auto
# When 1, allow fake engines outside explicit pin (CI / Playwright).
AUDIO_RECOVERY_FAKE_MODE=0
# AUDIO_RECOVERY_SIDECAR_BASE_URL=http://audio-recovery:8091
# AUDIO_RECOVERY_MAX_ASSETS_PER_PROJECT=10
# AUDIO_RECOVERY_MAX_JOBS_PER_PROJECT=20
# AUDIO_RECOVERY_MAX_TOTAL_BYTES=524288000
# AUDIO_RECOVERY_JOB_TIMEOUT_SECONDS=600
# AUDIO_RECOVERY_SYNC_MAX_SECONDS=30
# Optional Compose profile (never pulled by default up):
#   docker compose -f docker-compose.yml -f compose.audio-recovery.yml --profile audio-recovery up

# --- Video scoring (one immutable MP4/MOV per project; never mutates composition.v2) ---
# Bytes under VIDEO_ASSET_ROOT (never DATASET_ROOT or PROJECT_DB_PATH). See docs/video-scoring.md.
# VIDEO_ASSET_ROOT=  # default: <dir of PROJECT_DB_PATH>/video_assets
# VIDEO_ASSET_MAX_UPLOAD_BYTES=268435456  # default 256 MiB; clamped to 1 MiB–1 GiB

# --- Optional neural audio rendering (egress only; never mutates composition.v2) ---
# Distinct from FluidSynth Export WAV and AUDIO_* transcription. See docs/neural-audio-rendering.md.
# NEURAL_AUDIO_RENDER_ROOT=  # default: <dir of PROJECT_DB_PATH>/neural_audio_renders (never DATASET_ROOT)
# auto | fake:neural-audio | sidecar:musicgen | local:midi-ddsp
NEURAL_AUDIO_ENGINE=auto
# When 1, allow fake:neural-audio outside explicit engine pin (CI / Playwright).
NEURAL_AUDIO_FAKE_MODE=0
# NEURAL_AUDIO_SIDECAR_BASE_URL=http://neural-audio:8090
# NEURAL_AUDIO_MAX_CONCURRENCY=1
# NEURAL_AUDIO_MAX_RENDERS_PER_PROJECT=20
# NEURAL_AUDIO_MAX_PROMPT_CHARS=2000
# NEURAL_AUDIO_JOB_TIMEOUT_SECONDS=600
# NEURAL_AUDIO_MAX_AUDIO_SECONDS=120
# NEURAL_AUDIO_MAX_TOTAL_BYTES=524288000
# Attempts per render or stem-set job, including the first. Range 1–5. Default 2.
# NEURAL_AUDIO_MAX_ATTEMPTS=2
# Optional Compose profile (never pulled by default up):
#   docker compose -f docker-compose.yml -f compose.neural-audio.yml --profile neural-audio up
# AI_OP_AUDIO_RENDER=fake:neural-audio
# AI_FALLBACK_AUDIO_RENDER=

# --- Mix analysis (read-only DSP over neural stem/mix WAVs; never mutates audio/V2) ---
# Report JSON under MIX_ANALYSIS_ROOT (never DATASET_ROOT). See docs/mix-analysis.md.
# MIX_ANALYSIS_ROOT=  # default: <dir of PROJECT_DB_PATH>/mix_analysis_reports
MIX_ANALYSIS_FAKE_MODE=0
# MIX_ANALYSIS_MAX_AUDIO_SECONDS=120
# MIX_ANALYSIS_MAX_TOTAL_INPUT_BYTES=209715200
# MIX_ANALYSIS_MAX_REPORTS_PER_PROJECT=40
# MIX_ANALYSIS_JOB_TIMEOUT_SECONDS=90
# MIX_ANALYSIS_SERIES_MAX_POINTS=256
# MIX_ANALYSIS_OBSERVATION_MAX=64
# Optional richer DSP (not required for CI):
#   pip install -r backend/requirements-mix-analysis.txt

# --- Performance conductor (performance.plan.v1; see docs/performance-conductor.md) ---
# Optional AI dimension patches only; default off. Never rewrites pitch/harmony.
PERFORMANCE_CONDUCTOR_AI_ENABLED=false

# --- Spatial music scene / preview (spatial.scene.v1; see docs/spatial-music.md) ---
# Caps match Task 1 freezes; optional overrides only.
# SPATIAL_PREVIEW_MAX_SOURCES=32
# SPATIAL_PREVIEW_MAX_MOTION_KEYFRAMES=64

# --- Mix plans (non-destructive mix/master revisions; never overwrite stems) ---
# See docs/ai-assisted-mixing.md. Targets are goals, not loudness guarantees.
# MIX_PLAN_ROOT=  # default: <dir of PROJECT_DB_PATH>/mix_plans
MIX_PLAN_FAKE_MODE=0
# MIX_PLAN_MAX_AUDIO_SECONDS=120
# MIX_PLAN_PREVIEW_MAX_SECONDS=30
# MIX_PLAN_MAX_TOTAL_INPUT_BYTES=209715200
# MIX_PLAN_MAX_REVISIONS_PER_PROJECT=40
# MIX_PLAN_JOB_TIMEOUT_SECONDS=90

# --- Content provenance (durable derivation graph; optional C2PA egress) ---
# See docs/content-provenance.md. Capture is always on. Credentials default off.
# CONTENT_PROVENANCE_MAX_RECORDS_PER_PROJECT=4000
# CONTENT_PROVENANCE_MANIFEST_MAX_RECORDS=64
# CONTENT_PROVENANCE_CHAIN_MAX_DEPTH=32
# Provenance capture is always on (no CONTENT_PROVENANCE_ENABLED).
#
# Rights-governance registry (studio SQLite; caps only — not on /ready)
# RIGHTS_GOVERNANCE_MAX_ENTRIES_PER_PROJECT=256
# RIGHTS_GOVERNANCE_MAX_ATTRIBUTION_CHARS=500

# CONTENT_CREDENTIALS_ENABLED=0
# CONTENT_CREDENTIALS_FAKE=0
# CONTENT_CREDENTIALS_ROOT=   # default: <dir of PROJECT_DB_PATH>/content_credentials

# --- Optional agent artifact workspace (immutable typed plans; promote on Apply) ---
# Session-default until multi-agent-apply; optional temps when persist_workspace_artifacts=true.
# AGENT_ARTIFACT_TEMP_TTL_HOURS=24
# AGENT_ARTIFACT_TEMP_MAX_PER_PROJECT=200
# AGENT_ARTIFACT_PAYLOAD_INSPECT_MAX_BYTES=65536

# Music Evaluation Engine (optional climax thresholds)
# CRITIQUE_CLIMAX_NOTE_LOAD_DELTA_MAX=0.08
# CRITIQUE_CLIMAX_VELOCITY_DELTA_MAX=0.10
# CRITIQUE_TREAT_CHORUS_AS_CLIMAX=false

# Adaptive score document caps (adaptive.score.v1; see docs/adaptive-score.md)
# ADAPTIVE_SCORE_MAX_STATES=32
# ADAPTIVE_SCORE_MAX_VARIANTS_PER_STATE=8
# ADAPTIVE_SCORE_MAX_TRANSITIONS=64
# ADAPTIVE_SCORE_MAX_LAYERS=32
# ADAPTIVE_SCORE_MAX_STINGERS=32
# ADAPTIVE_SCORE_MAX_CONDITIONS=8
# ADAPTIVE_SCORE_MAX_NAME_LENGTH=80
# ADAPTIVE_SCORE_MAX_BODY_BYTES=262144

# Adaptive music engine (external session; see docs/adaptive-music-engine.md)
# ADAPTIVE_ENGINE_TOKEN is unset by default. Unset allows only the direct
# loopback peers 127.0.0.1 and ::1. Starlette testclient is not loopback.
# When set, every peer must send Authorization: Bearer. The value is never logged.
# ADAPTIVE_ENGINE_TOKEN=
# ADAPTIVE_ENGINE_TICK_MS=50
# ADAPTIVE_ENGINE_TICKER=auto
# ADAPTIVE_ENGINE_CONTEXT_HZ=20
# ADAPTIVE_ENGINE_CONTEXT_BURST=40
# ADAPTIVE_ENGINE_COMMAND_HZ=8
# ADAPTIVE_ENGINE_COMMAND_BURST=8
# ADAPTIVE_ENGINE_STATUS_HZ=10
# ADAPTIVE_ENGINE_MAX_SESSIONS=4
# ADAPTIVE_ENGINE_EVENT_QUEUE=32

# Adaptive music client demo (external process; see docs/adaptive-music-client.md).
# The score already exists. These names are not server settings. Leave the token empty here.
# MUKIT_ADAPTIVE_BASE_URL=http://127.0.0.1:8000
# MUKIT_ADAPTIVE_PROJECT_ID=
# MUKIT_ADAPTIVE_SCORE_ID=
# MUKIT_ADAPTIVE_DOCUMENT_REVISION=
# MUKIT_ADAPTIVE_TOKEN=
# MUKIT_ADAPTIVE_PHASES=
# MUKIT_ADAPTIVE_LOG_LEVEL=INFO

# Adaptive runtime continuation (session buffer only; see docs/adaptive-runtime-continuation.md)
# Invalid values keep the default. DEADLINE_MS may be 0 so a test can discard a late model.
# ADAPTIVE_CONTINUATION_PLAY_BARS=5
# ADAPTIVE_CONTINUATION_GENERATE_BARS=8
# ADAPTIVE_CONTINUATION_PREFIX_BARS=8
# ADAPTIVE_CONTINUATION_DEADLINE_MS=250
# ADAPTIVE_CONTINUATION_LATENCY_BUDGET_MS=50
# ADAPTIVE_CONTINUATION_INTENSITY_EPSILON=0.25
# ADAPTIVE_CONTINUATION_MAX_BUFFER_EVENTS=512
# Studio continuous / virtual timeline (default off). Not on /ready.
# ADAPTIVE_CONTINUOUS_ENABLED=0
# Engine continuous maintain proxy; requires studio continuous on (default off).
# ADAPTIVE_ENGINE_CONTINUOUS_ENABLED=0

# Controlled critique → revision loop (preview only; default off / max_passes=0)
# REVISION_LOOP_IMPROVEMENT_MIN_DELTA=1
# REVISION_LOOP_HARD_WEIGHT=100
# REVISION_LOOP_TECHNICAL_WEIGHT=10
# REVISION_LOOP_STOP_WHEN_HARD_OK=true
# REVISION_LOOP_REVISE_ON_TECHNICAL=false
# REVISION_LOOP_ON_FAILURE=keep_last_valid_and_stop
# REVISION_LOOP_MAX_WALL_MS_FAST=60000
# REVISION_LOOP_MAX_WALL_MS_BALANCED=120000
# REVISION_LOOP_MAX_WALL_MS_THOROUGH=180000
# REVISION_LOOP_MAX_PROMPT_TOKENS_FAST=8000
# REVISION_LOOP_MAX_PROMPT_TOKENS_BALANCED=24000
# REVISION_LOOP_MAX_PROMPT_TOKENS_THOROUGH=48000

# Autonomous-run ceilings (workflow preview and single-agent). See docs/observability.md.
# Token and cost caps fire only when the provider reports those numbers.
# OPERATION_MAX_MODEL_CALLS=32
# OPERATION_MAX_RUNTIME_MS=180000
# OPERATION_MAX_PROMPT_TOKENS=
# OPERATION_REMOTE_COST_MICROS=
# OPERATION_MAX_REVISIONS=8
# NEURAL_AUDIO_MAX_ATTEMPTS=2

# Autonomous project composer (see docs/autonomous-composer.md). A request may only lower the agent cap.
# AUTONOMOUS_MAX_AGENT_OPERATIONS=24
# AUTONOMOUS_MAX_RUNS_PER_PROJECT=20

# --- Offline symbolic dataset pipeline (optional; not required for app up) ---
# Filesystem corpora only — never PROJECT_DB_PATH / user projects.
# See docs/datasets.md. CLI: python -m app.dataset.cli build --config …
# DATASET_ROOT=./datasets
# DATASET_TARGET_PPQ=480
# DATASET_COLLAPSE_DUP_NOTES=1
# DATASET_MAX_SOURCE_BYTES=50000000
# DATASET_MAX_NOTES=500000
# DATASET_MAX_BARS=4096
# DATASET_SPLIT_SEED=20260921
# DATASET_TRAIN_RATIO=0.8
# DATASET_VAL_RATIO=0.1
# DATASET_TEST_RATIO=0.1
# Train eligibility (hard-coded default): verified_redistributable|user_owned|public_domain only

# --- Symbolic music tokenizer (optional; CLI/library only; not required for app up) ---
# Composition V2 ↔ token ids. Never PROJECT_DB_PATH / user projects.
# See docs/tokenizer.md. CLI: python -m app.tokenizer.cli …
# TOKENIZER_TICKS_PER_QUARTER=480
# TOKENIZER_GRID_SUBDIVISIONS_PER_QUARTER=4
# TOKENIZER_VELOCITY_BINS=32
# TOKENIZER_MAX_DUR_STEPS=64
# TOKENIZER_MAX_TRACKS=32
# TOKENIZER_MAX_VOCAB_SIZE=8192
# TOKENIZER_REQUIRE_BOS_EOS=1
# TOKENIZER_PROFILE=core

# --- Symbolic Music Transformer (optional; torch extra; CLI/library) ---
# Decoder-only LM over tokenizer.v1. Never PROJECT_DB_PATH / GGUF in FastAPI.
# Install: pip install -r backend/requirements-music-transformer.txt
# See docs/music-transformer.md. CLI: python -m app.music_transformer.cli …
# MUSIC_TRANSFORMER_DEVICE=cpu
# MUSIC_TRANSFORMER_DEVICE_FALLBACK=
# MUSIC_TRANSFORMER_SEED=42
# MUSIC_TRANSFORMER_CHECKPOINT_DIR=checkpoints/music_transformer
# MUSIC_TRANSFORMER_EXPERIMENT_ROOT=experiments/music_transformer
# MUSIC_TRANSFORMER_CHECKPOINT=  # basename or path under CHECKPOINT_DIR / allowed roots only
# MUSIC_TRANSFORMER_ALLOWED_ROOTS=  # optional comma-separated absolute roots (Compose mounts)
# Paths outside CHECKPOINT_DIR / models/ / ALLOWED_ROOTS → 422 model_path_rejected (no auto-download).
# MUSIC_TRANSFORMER_API_ENABLED=0
# MUSIC_TRANSFORMER_GRAPH_ENABLED=0  # allow hybrid graph to mark local:music-transformer ready without HTTP API

# Personal symbolic composer. Training starts only on POST /personal-composers.
# PERSONAL_COMPOSER_ROOT must not be DATASET_ROOT or PROJECT_DB_PATH.
# PERSONAL_COMPOSER_ROOT=personal_composers
# PERSONAL_COMPOSER_FAKE=0
# PERSONAL_COMPOSER_MAX_PROJECTS=8
# PERSONAL_COMPOSER_MAX_STEPS=50
# Offline MT CLI remains the primary corpus train path. Opt-in Model Lab may train
# in-process when MODEL_LAB_ENABLED=1 (see docs/model-lab.md).
# Never curl/download weights on compose up; mount installed checkpoints explicitly.

# Model Lab (corpus MT research UI). Mutating routes require MODEL_LAB_ENABLED=1.
# MODEL_LAB_ROOT must not be DATASET_ROOT or PROJECT_DB_PATH. Default FS is already
# covered by .gitignore experiments/.
# MODEL_LAB_ENABLED=0
# MODEL_LAB_FAKE=0
# MODEL_LAB_ROOT=experiments/music_transformer
# MODEL_LAB_MAX_STEPS=64
# MODEL_LAB_MAX_BATCH=8
# MODEL_LAB_MAX_CONCURRENT=1
# MODEL_LAB_MAX_COMPARE=8
# MODEL_LAB_ALLOW_ACCELERATOR=0
# MODEL_LAB_RETENTION=50
# --- Symbolic composition embeddings (handcrafted features; no torch required) ---
# Musical similarity / reference conditioning. Never artist≡style ids.
# Cache beside project data — never DATASET_ROOT. Default corpus = user projects.
# See docs/embeddings.md (added with this feature).
# EMBEDDING_CACHE_DIR=  # default: <dir of PROJECT_DB_PATH>/embedding_cache
# EMBEDDING_CACHE_LRU_SIZE=256
# EMBEDDING_MAX_DIMS=256
# EMBEDDING_DEFAULT_TOP_K=10
# EMBEDDING_MAX_TOP_K=50
# EMBEDDING_INDEX_MAX_PROJECTS=500
# EMBEDDING_INDEX_MAX_ENTRIES=5000
# EMBEDDING_ALLOW_DATASET_CORPUS=0
# EMBEDDING_DISTANCE_METRIC=cosine
# EMBEDDING_FEATURE_SUMMARY_MAX_CHARS=1200
# EMBEDDING_PROMPT_VECTOR_MAX_DIMS=0
# EMBEDDING_PROJECTION_ID=none

# --- Composer profiles (durable musical preferences; PROJECT_DB_PATH only) ---
# Soft-condition generate only; never override prompt/hard constraints.
# Never auto-export to DATASET_ROOT. See docs/composer-profiles.md.
# COMPOSER_PROFILE_MAX_PROFILES=50
# COMPOSER_PROFILE_MAX_SOURCE_PROJECTS=16
# COMPOSER_PROFILE_MAX_EXPORT_BYTES=262144
# COMPOSER_PROFILE_FRAGMENT_MAX_CHARS=1200
# COMPOSER_PROFILE_MAX_LIST_ITEMS=16

# --- Reference features (selective musical reference conditioning; no DATASET_ROOT) ---
# REFERENCE_FEATURES_MAX_REFERENCES=3
# REFERENCE_FEATURES_SUMMARY_MAX_CHARS=280
# REFERENCE_FEATURES_SOFT_FRAGMENT_MAX_CHARS=1600
# REFERENCE_FEATURES_ANALYZE_LRU_SIZE=0
# REFERENCE_FEATURES_POLICY_DIGEST_PREFIX_LEN=16
# REFERENCE_FEATURES_STRENGTH_LEGEND_MAX_CHARS=240

# --- Co-performance live accompaniment (ephemeral; never PROJECT_DB / DATASET_ROOT) ---
# Horizon bars default 1–2; predict is optional cold-path fill behind local degradation.
# LIVE_HORIZON_BARS=1
# LIVE_HORIZON_BARS_MIN=1
# LIVE_HORIZON_BARS_MAX=2
# LIVE_HORIZON_MS=2000
# LIVE_HORIZON_MS_MIN=250
# LIVE_HORIZON_MS_MAX=8000
# LIVE_ACCOMP_MAX_EVENTS_PER_CHUNK=64
# LIVE_PREDICT_MAX_FEATURES_BYTES=4096
# LIVE_PREDICT_TIMEOUT_MS=1500
# LIVE_PREDICT_MAX_IN_FLIGHT=1
# LIVE_SCHEDULE_SLACK_MS=80
# Frontend mirrors (optional): VITE_LIVE_HORIZON_BARS, VITE_LIVE_HORIZON_MS,
# VITE_LIVE_ACCOMP_MAX_EVENTS_PER_CHUNK, VITE_LIVE_PREDICT_MAX_FEATURES_BYTES,
# VITE_LIVE_PREDICT_TIMEOUT_MS, VITE_LIVE_SCHEDULE_SLACK_MS
# AI Jam hysteresis / analysis window (optional):
# LIVE_JAM_HARMONY_CONFIDENCE_MIN=0.55
# LIVE_JAM_HARMONY_DWELL_MS=400
# LIVE_JAM_HARMONY_DWELL_MS_FLOOR=150
# LIVE_JAM_HARMONY_HYSTERESIS=0.15
# LIVE_JAM_ANALYSIS_MAX_EVENTS=48
# LIVE_JAM_ANALYSIS_MAX_TICKS=1920
# Frontend mirrors: VITE_LIVE_JAM_HARMONY_CONFIDENCE_MIN, VITE_LIVE_JAM_HARMONY_DWELL_MS,
# VITE_LIVE_JAM_HARMONY_DWELL_MS_FLOOR, VITE_LIVE_JAM_HARMONY_HYSTERESIS,
# VITE_LIVE_JAM_ANALYSIS_MAX_EVENTS, VITE_LIVE_JAM_ANALYSIS_MAX_TICKS

# --- Arrangement instrument catalog (optional override) ---
# Absolute path *inside the backend container/process* to a validated
# arrangement.instruments.v1 JSON file. Unset = packaged fixture
# (backend/app/fixtures/arrangement_instruments.v1.json).
# Host paths are not used unless bind-mounted into the container.
# Example with compose.dev.yml read-only volume:
#   ./my-catalog.json:/data/arrangement_instruments.v1.json:ro
# ARRANGEMENT_INSTRUMENT_CATALOG_PATH=/data/arrangement_instruments.v1.json
#
# Frontend arrangement log verbosity (Vite): VITE_LOG_LEVEL=debug|info|warn|error|silent
# (see frontend/src/utils/appLogger.js; production defaults reduce noise).

# --- BrowserModel / WebGPU inference (Vite-side only) ---
# These flags are read by the SPA (import.meta.env), not by the FastAPI process.
# Default true when unset. Effective enable still requires capability probe + twin.
# VITE_BROWSER_MODELS_ENABLED=true
# Skip WebGPU sub-path (batched cosine) while keeping browser CPU twin / HTTP:
# VITE_BROWSER_MODELS_WEBGPU=true
# See docs/browser-webgpu-inference.md. Backend /ready reports soft browser_models
# from the AI registry only (never scans frontend/public).
#
# Expressive MIDI (SPA): higher-res velocity / MPE / optional UMP ship-subset.
# Default true when unset. Falsy forces legacy note-on/off + CC64-only path.
# VITE_MIDI_EXPRESSIVE_ENABLED=true
# See docs/midi-live-input.md.

# --- Runtime ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Offline musical workflow benchmark reports. Default is <repo>/var/workflow-benchmarks.
# The loader refuses a root that resolves to DATASET_ROOT or PROJECT_DB_PATH.
# EVAL_BENCHMARK_ROOT=

# Comma-separated browser origins allowed by CORS (host-local Vite / published site).
# Same-origin nginx proxy does not need listing; keep localhost for `npm run dev`.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
