# Copy to `.env` and fill in at least one provider API key.
# Never commit `.env` — secrets stay on the host / in Compose env only.

# --- LLM providers (backend only; never expose to the frontend) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# openai | deepseek (must match a configured provider key)
DEFAULT_LLM_PROVIDER=openai
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.7

# --- Persistence & rendering ---
# Docker Compose sets PROJECT_DB_PATH=/data/projects.db on the named volume.
PROJECT_DB_PATH=/data/projects.db
COMPOSITION_WAV_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2

# --- Runtime ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS (host-local Vite / published site).
# Same-origin nginx proxy does not need listing; keep localhost for `npm run dev`.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
